{
  "name": "memos-sync",
  "version": "0.1.0",
  "description": "Two-way sync between plugin-owned notes in Super Productivity and Memos",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "npm run typecheck && node scripts/bundle.js",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "super-productivity",
    "memos",
    "sync",
    "plugin",
    "notes"
  ],
  "author": "Giba0 <gilberto.olimpio@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/giba0/memos-sync.git"
  },
  "homepage": "https://github.com/giba0/memos-sync",
  "bugs": {
    "url": "https://github.com/giba0/memos-sync/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  }
}
